loki.write "ikun" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

discovery.relabel "sub2api_journal" {
	targets = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		regex         = "sub2api.service"
		action        = "keep"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		target_label = "host"
		replacement  = "ikun"
	}

	rule {
		target_label = "service"
		replacement  = "sub2api"
	}

	rule {
		target_label = "source"
		replacement  = "journald"
	}
}

loki.source.journal "sub2api" {
	path          = "/var/log/journal"
	max_age       = "5m"
	relabel_rules = discovery.relabel.sub2api_journal.rules
	forward_to    = [loki.process.sub2api.receiver]
	labels        = {
		job = "ikun/sub2api",
	}
}

loki.process "sub2api" {
	stage.match {
		selector = "{job=\"ikun/sub2api\"}"

		stage.regex {
			expression = "(?s)^(?P<prefix>.*?)\\t(?P<event>[^\\t]+)\\t(?P<payload>\\{.*\\})$"
		}

		stage.output {
			source = "payload"
		}

		stage.json {
			expressions = {
				level             = "level",
				component         = "component",
				platform          = "platform",
				status_code       = "status_code",
				request_id        = "request_id",
				client_request_id = "client_request_id",
				model             = "model",
				latency_ms        = "latency_ms",
			}
		}

		stage.labels {
			values = {
				level     = "level",
				component = "component",
				platform  = "platform",
			}
		}

		stage.structured_metadata {
			values = {
				event             = "event",
				status_code       = "status_code",
				request_id        = "request_id",
				client_request_id = "client_request_id",
				model             = "model",
				latency_ms        = "latency_ms",
			}
		}
	}

	forward_to = [loki.write.ikun.receiver]
}

local.file_match "openresty_error" {
	path_targets = [{
		__path__ = "/var/log/openresty/ikun-error.log",
		host     = "ikun",
		job      = "ikun/openresty-error",
		service  = "openresty",
		source   = "file",
	}]
}

loki.source.file "openresty_error" {
	targets       = local.file_match.openresty_error.targets
	tail_from_end = true
	forward_to    = [loki.process.openresty_error.receiver]
}

loki.process "openresty_error" {
	stage.regex {
		expression = "^(?P<time>\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2}) \\[(?P<level>[^\\]]+)\\]"
	}

	stage.labels {
		values = {
			level = "level",
		}
	}

	forward_to = [loki.write.ikun.receiver]
}
