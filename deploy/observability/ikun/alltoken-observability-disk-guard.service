[Unit]
Description=Protect ikun root disk from observability log growth
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=STACK_DIR=/opt/alltoken-observability/ikun
Environment=LOKI_MAX_KIB=15728640
Environment=ROOT_MIN_FREE_KIB=20971520
ExecStart=/opt/alltoken-observability/ikun/disk-guard.sh
