        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "query_result(alltoken_channel_info)",
        "hide": 0,
        "includeAll": true,
        "label": "Channel",
        "multi": true,
        "name": "channel",
        "options": [],
        "query": { "query": "query_result(alltoken_channel_info)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "/channel_id=\"(?<value>[^\"]+)\".*channel_label=\"(?<text>[^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
