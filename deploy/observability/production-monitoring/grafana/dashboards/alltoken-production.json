      "targets": [
        { "expr": "sum by (error_class) (rate(new_api_relay_requests_total{channel_id!=\"\",channel_id=~\"$channel\",outcome=\"error\"}[1m]))", "legendFormat": "final / {{error_class}}", "refId": "A" },
        { "expr": "sum by (error_class, upstream_status) (rate(new_api_relay_attempts_total{channel_id!=\"\",channel_id=~\"$channel\",error_class!=\"success\"}[1m]))", "legendFormat": "attempt / {{error_class}} / {{upstream_status}}", "refId": "B" }
