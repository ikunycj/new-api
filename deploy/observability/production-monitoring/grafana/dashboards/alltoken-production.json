      "targets": [{ "expr": "100 * sum(rate(new_api_relay_requests_total{channel_id!=\"\",channel_id=~\"$channel\",outcome=\"error\"}[5m])) / clamp_min(sum(rate(new_api_relay_requests_total{channel_id!=\"\",channel_id=~\"$channel\"}[5m])), 0.001)", "refId": "A" }],
      "title": "Final error rate",
