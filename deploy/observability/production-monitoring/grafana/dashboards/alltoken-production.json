      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (final_status) (rate(new_api_relay_requests_total{channel_id!=\"\",channel_id=~\"$channel\"}[1m]))", "legendFormat": "HTTP {{final_status}}", "refId": "A" }],
