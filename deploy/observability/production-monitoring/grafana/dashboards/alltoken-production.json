      "targets": [{ "expr": "100 * sum(rate(alltoken_pool_requests_total{cluster_code=~\"$cluster\",outcome=\"error\"}[5m])) / clamp_min(sum(rate(alltoken_pool_requests_total{cluster_code=~\"$cluster\"}[5m])), 0.001)", "refId": "A" }],
