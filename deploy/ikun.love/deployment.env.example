# Non-secret operator settings for the ikun.love release.
# Keep the real deployment.env outside Git and do not put app secrets here.

DEPLOY_HOST=ikun.love
RELEASE_REF=ikun.love
PUBLIC_ORIGIN=https://ikun.love
PUBLIC_STATUS_URL=
EXISTING_PUBLIC_HEALTH_URL=https://ikun.love/api/v1/settings/public
EXISTING_LOCAL_HEALTH_URL=http://127.0.0.1:8080/api/v1/settings/public

# Isolated app and database defaults. These values must not overlap with
# /opt/sub2api.
DEPLOY_DIR=/opt/new-api
COMPOSE_FILE=docker-compose.1panel.yml
ENV_FILE=.env
BASE_IMAGE=calciumion/new-api:latest
IMAGE_TAG=new-api:ikun
SERVICE=new-api
CONTAINER=ikun-new-api
DATABASE_MODE=postgresql
POSTGRES_CONTAINER=1Panel-postgresql-8Kr6
POSTGRES_DATABASE=new_api
POSTGRES_ROLE=new_api_app
REDIS_MODE=database-1
REDIS_CONTAINER=1Panel-redis-xsdn
LOCAL_STATUS_URL=http://127.0.0.1:3000/api/status
HEALTH_TIMEOUT=120
