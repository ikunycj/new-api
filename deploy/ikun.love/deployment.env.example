# Non-secret operator settings for the complete ikun.love Docker stack.
# Keep the real deployment.env outside Git.

DEPLOY_HOST=ikun.love
RELEASE_REF=ikun.love
PUBLIC_ORIGIN=https://ikun.love
PUBLIC_STATUS_URL=
EXISTING_PUBLIC_HEALTH_URL=https://ikun.love/api/v1/settings/public
EXISTING_LOCAL_HEALTH_URL=http://127.0.0.1:8080/api/v1/settings/public

DEPLOY_DIR=/opt/new-api
COMPOSE_PROJECT_NAME=ikun-new-api
COMPOSE_FILE=docker-compose.1panel.yml
ENV_FILE=.env
BASE_IMAGE=calciumion/new-api:latest
IMAGE_TAG=new-api:ikun
SERVICE=new-api
CONTAINER=ikun-new-api
LOCAL_STATUS_URL=http://127.0.0.1:3000/api/status
HEALTH_TIMEOUT=300

# Dedicated data services. They must never be replaced with the 1Panel
# Sub2API containers or attached to 1panel-network.
POSTGRES_IMAGE=postgres:18.4-alpine
POSTGRES_CONTAINER=ikun-new-api-postgres
POSTGRES_ADMIN_DB=postgres
POSTGRES_DATABASE=new_api
POSTGRES_ROLE=new_api_app
REDIS_IMAGE=redis:8.8.0
REDIS_CONTAINER=ikun-new-api-redis
REDIS_DB=0
NETWORK_NAME=ikun-new-api-network
POSTGRES_VOLUME=ikun-new-api-postgres-data
REDIS_VOLUME=ikun-new-api-redis-data
