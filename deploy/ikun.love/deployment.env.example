# Non-secret operator settings for the ikun.love release.
# Keep the real deployment.env outside Git and do not put app secrets here.

DEPLOY_HOST=ikun.love
RELEASE_REF=ikun.love
PUBLIC_ORIGIN=https://ikun.love
PUBLIC_STATUS_URL=https://ikun.love/api/status

# Verify these paths and names with a read-only baseline before the first run.
DEPLOY_DIR=/opt/new-api
COMPOSE_FILE=docker-compose.1panel.yml
ENV_FILE=.env
IMAGE_TAG=new-api:local
SERVICE=new-api
CONTAINER=new-api
POSTGRES_CONTAINER=REPLACE_WITH_TARGET_POSTGRES_CONTAINER
REDIS_CONTAINER=REPLACE_WITH_TARGET_REDIS_CONTAINER
LOCAL_STATUS_URL=http://127.0.0.1:3000/api/status
HEALTH_TIMEOUT=120
