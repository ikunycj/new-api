# Target application environment template for https://ikun.love.
#
# This is a documentation-only template. Create the real server-side .env
# independently, keep it mode 600, and never commit or upload this file as-is.

# Compose / application listener
APP_PORT=3000
METRICS_HOST_PORT=8006
METRICS_PORT=8006

# Existing 1Panel PostgreSQL service. Verify names and values on ikun.love.
POSTGRES_HOST=REPLACE_WITH_TARGET_POSTGRES_CONTAINER
POSTGRES_PORT=5432
POSTGRES_USER=REPLACE_WITH_EXISTING_TARGET_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_TARGET_DB_PASSWORD
POSTGRES_DB=REPLACE_WITH_EXISTING_TARGET_DB_NAME

# Existing 1Panel Redis service. Verify names and values on ikun.love.
REDIS_HOST=REPLACE_WITH_TARGET_REDIS_CONTAINER
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=REPLACE_WITH_EXISTING_TARGET_REDIS_PASSWORD

# Preserve the existing values on the target across releases.
SESSION_SECRET=REPLACE_WITH_EXISTING_TARGET_SESSION_SECRET
CRYPTO_SECRET=REPLACE_WITH_EXISTING_TARGET_CRYPTO_SECRET
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://ikun.love
TRUSTED_REDIRECT_DOMAINS=ikun.love

# Runtime identity and safe defaults for the single target node.
TZ=Asia/Shanghai
NODE_NAME=ikun-new-api-1
NODE_TYPE=master
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
ENABLE_METRICS=true
METRICS_BIND_ADDRESS=0.0.0.0

# Optional monitoring integrations. Leave empty unless already configured.
FAILOVER_PROMETHEUS_URL=
FAILOVER_ALERTMANAGER_URL=
FAILOVER_GRAFANA_PUBLIC_URL=
FAILOVER_MONITORING_USERNAME=
FAILOVER_MONITORING_PASSWORD=
FAILOVER_MONITORING_BEARER_TOKEN=
