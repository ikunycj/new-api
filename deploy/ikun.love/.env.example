# Isolated new-api environment template for the ikun.love host.
#
# The initial deployment is deliberately independent from /opt/sub2api. It
# uses a new database and role inside the existing PostgreSQL container, and
# uses Redis logical database 1 in the existing Redis container. Keep the real
# /opt/new-api/.env mode 600 and never
# commit or print its values.

APP_PORT=3000
METRICS_HOST_PORT=8006
METRICS_PORT=8006
SQLITE_PATH=/data/new-api.db?_busy_timeout=30000

# These values are created for this new-api instance only. The deployment
# bootstrap creates the database/role and writes the real DSN privately.
SQL_DSN=postgresql://new_api_app:REPLACE_WITH_NEW_API_DB_PASSWORD@1Panel-postgresql-8Kr6:5432/new_api?sslmode=disable

SESSION_SECRET=REPLACE_WITH_NEW_API_SESSION_SECRET
CRYPTO_SECRET=REPLACE_WITH_NEW_API_CRYPTO_SECRET

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
TRUSTED_REDIRECT_DOMAINS=ikun.love

TZ=Asia/Shanghai
NODE_NAME=ikun-new-api-1
NODE_TYPE=master
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
ENABLE_METRICS=true
METRICS_BIND_ADDRESS=0.0.0.0

FAILOVER_PROMETHEUS_URL=
FAILOVER_ALERTMANAGER_URL=
FAILOVER_GRAFANA_PUBLIC_URL=
FAILOVER_MONITORING_USERNAME=
FAILOVER_MONITORING_PASSWORD=
FAILOVER_MONITORING_BEARER_TOKEN=

# Redis logical database 0 is owned by Sub2API; the bootstrap writes the
# existing Redis auth value with database 1 into the real file without printing
# it. Do not point this at db0.
REDIS_CONN_STRING=redis://:REPLACE_WITH_EXISTING_REDIS_PASSWORD@1Panel-redis-xsdn:6379/1
