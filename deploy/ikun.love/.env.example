# Complete isolated Docker stack for the ikun.love new-api install.
#
# bootstrap-config.sh generates the real file with mode 600. Replace every
# placeholder only when preparing a manual bootstrap; never copy Sub2API
# credentials into this file.

COMPOSE_PROJECT_NAME=ikun-new-api
NETWORK_NAME=ikun-new-api-network
POSTGRES_VOLUME=ikun-new-api-postgres-data
REDIS_VOLUME=ikun-new-api-redis-data

APP_PORT=3000
METRICS_HOST_PORT=8006
METRICS_PORT=8006
IMAGE_TAG=new-api:ikun
CONTAINER=ikun-new-api

# PostgreSQL has a private bootstrap administrator and a separate application
# role. Only POSTGRES_APP_USER/PASSWORD are used in the new-api DSN.
POSTGRES_IMAGE=postgres:18.4-alpine
POSTGRES_CONTAINER=ikun-new-api-postgres
POSTGRES_ADMIN_USER=ikun_pg_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_ADMIN_PASSWORD
POSTGRES_ADMIN_DB=postgres
POSTGRES_DB=new_api
POSTGRES_APP_USER=new_api_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_APP_PASSWORD

# This Redis container is dedicated to new-api, so its database index is 0.
REDIS_IMAGE=redis:8.8.0
REDIS_CONTAINER=ikun-new-api-redis
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_DB=0

SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
CRYPTO_SECRET=REPLACE_WITH_RANDOM_CRYPTO_SECRET
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_TRUSTED_URL=
TRUSTED_REDIRECT_DOMAINS=ikun.love

TZ=Asia/Shanghai
NODE_NAME=ikun-new-api-1
NODE_TYPE=master
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
ENABLE_METRICS=true
METRICS_BIND_ADDRESS=0.0.0.0
SQL_MAX_IDLE_CONNS=10
SQL_MAX_OPEN_CONNS=30
SQL_MAX_LIFETIME=60
REDIS_POOL_SIZE=10

FAILOVER_PROMETHEUS_URL=
FAILOVER_ALERTMANAGER_URL=
FAILOVER_GRAFANA_PUBLIC_URL=
FAILOVER_MONITORING_USERNAME=
FAILOVER_MONITORING_PASSWORD=
FAILOVER_MONITORING_BEARER_TOKEN=
