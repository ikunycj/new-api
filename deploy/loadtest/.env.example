# Host ports. Change only when a local port is already occupied.
LOADTEST_API_PORT=3100
LOADTEST_GRAFANA_PORT=3001
LOADTEST_PROMETHEUS_PORT=9090
LOADTEST_ALERTMANAGER_PORT=9093
LOADTEST_ALERT_SINK_PORT=19094
LOADTEST_PYROSCOPE_PORT=4040
LOADTEST_PPROF_PORT=8005
LOADTEST_METRICS_PORT=8006
LOADTEST_POSTGRES_PORT=15432
LOADTEST_REDIS_PORT=16379
LOADTEST_MOCK_PORT=18080
LOADTEST_MOCK_B_PORT=18081

# Workload and mock-upstream behavior.
LOADTEST_USERS=1000
LOAD_PROFILE=smoke
# For remote tests, pass a comma-separated list through the environment only.
# Do not commit real tokens in this file.
LOADTEST_TOKENS=
# Alternatively, run-remote.sh can read one token per line or name + token per line.
LOADTEST_TOKEN_FILE=
MOCK_TTFT_MS=100
MOCK_RESPONSE_MS=500
MOCK_STREAM_CHUNKS=20
MOCK_STREAM_INTERVAL_MS=50
MOCK_ERROR_RATE=0
MOCK_A_CHANNEL_TOKENS=300
MOCK_B_CHANNEL_TOKENS=3000

# Single-channel capacity profile. Each target rate is held after a short ramp.
CAPACITY_RATES=100,200,300,400,500,600,700,800
CAPACITY_RAMP_DURATION=30s
CAPACITY_STAGE_DURATION=2m
CAPACITY_PREALLOCATED_VUS=500
CAPACITY_MAX_VUS=2000

# Deliberately finite pools: saturation should be visible instead of hidden.
SQL_MAX_OPEN_CONNS=80
SQL_MAX_IDLE_CONNS=40
SQL_MAX_LIFETIME=60
REDIS_POOL_SIZE=100
GRAFANA_ADMIN_PASSWORD=loadtest

# AllToken admin monitoring page. Keep Prometheus and Alertmanager private;
# only the Grafana public URL is rendered in the browser.
FAILOVER_PROMETHEUS_URL=http://prometheus:9090
FAILOVER_ALERTMANAGER_URL=http://alertmanager:9093
FAILOVER_GRAFANA_PUBLIC_URL=http://localhost:3001/d/new-api-loadtest?orgId=1&from=now-30m&to=now&timezone=browser&refresh=5s&kiosk
FAILOVER_MONITORING_USERNAME=
FAILOVER_MONITORING_PASSWORD=
FAILOVER_MONITORING_BEARER_TOKEN=

# Go module download settings used while building new-api.
# Override GOPROXY for a private mirror or another region if needed.
GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
GOSUMDB=sum.golang.google.cn
GOTOOLCHAIN=local
