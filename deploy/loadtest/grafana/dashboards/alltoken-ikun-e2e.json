{
  "uid": "alltoken-ikun-e2e",
  "title": "AllToken → ikun · End-to-end observability",
  "description": "Client → AllToken → ikun end-to-end health, relay outcomes, attempts, latency, host resources, and request-ID log drill-down.",
  "tags": ["alltoken", "ikun", "observability", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {"name": "provider", "label": "Provider", "type": "custom", "query": "ikun,other", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}},
      {"name": "request_id", "label": "Request ID / client request ID", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "text", "title": "How to read this dashboard", "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "options": {"mode": "markdown", "content": "**Flow:** Client → AllToken (`154.37.213.1`) → ikun (`192.204.35.79`) → model platform. Start with health and final outcomes, compare final requests with upstream attempts/retries, then use the Request ID field to correlate both Loki log panels.\n\nRelay metric panels intentionally show **No data until the observability-enabled AllToken image is released**. Host and ikun log panels are already live. Request IDs, URLs, channels, keys, and raw errors are never Prometheus labels."}
    },
    {
      "id": 2, "type": "stat", "title": "Collection targets healthy", "description": "Minimum scrape health across app, both hosts, Loki, Alloy, PostgreSQL, and Redis.", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "min(up{job=~\"new-api|node|node-ikun|postgres|redis|loki-alltoken|alloy-alltoken|loki-ikun|alloy-ikun\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "bool", "mappings": [{"type": "value", "options": {"0": {"text": "DEGRADED", "color": "red"}, "1": {"text": "HEALTHY", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "Final success ratio", "description": "Client-visible final results only; internal failed attempts do not reduce this ratio.", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(new_api_relay_requests_total{provider=~\"$provider\",outcome=\"success\"}[$__rate_interval])) / clamp_min(sum(rate(new_api_relay_requests_total{provider=~\"$provider\"}[$__rate_interval])), 0.001)"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "noValue": "Awaiting release", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 95}, {"color": "green", "value": 99}]}}, "overrides": []}
    },
    {
      "id": 4, "type": "stat", "title": "Retry ratio", "description": "Retries divided by final requests.", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(new_api_relay_retries_total{provider=~\"$provider\"}[$__rate_interval])) / clamp_min(sum(rate(new_api_relay_requests_total{provider=~\"$provider\"}[$__rate_interval])), 0.001)"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "noValue": "Awaiting release", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 25}]}}, "overrides": []}
    },
    {
      "id": 5, "type": "stat", "title": "Root disk free · minimum", "description": "Lowest free root-disk space across AllToken and ikun.", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "min(node_filesystem_avail_bytes{host=~\"alltoken|ikun\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "bytes", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 21474836480}, {"color": "green", "value": 32212254720}]}}, "overrides": []}
    },
    {"id": 6, "type": "row", "title": "Relay outcomes and attribution", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8}, "collapsed": false, "panels": []},
    {
      "id": 7, "type": "timeseries", "title": "Final request rate by outcome", "description": "Exactly one final result per client request.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (provider, outcome) (rate(new_api_relay_requests_total{provider=~\"$provider\"}[$__rate_interval]))", "legendFormat": "{{provider}} · {{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 18, "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "Error attribution by class", "description": "Fixed bounded classes distinguish auth/rate/quota/channel/upstream/timeout/cancel/internal failures.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (provider, error_class) (rate(new_api_relay_requests_total{provider=~\"$provider\",error_class!=\"success\"}[$__rate_interval]))", "legendFormat": "{{provider}} · {{error_class}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "bars", "fillOpacity": 55, "stacking": {"mode": "normal", "group": "errors"}}}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Final requests vs upstream attempts", "description": "Attempts above final requests indicate retries or failover.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (provider) (rate(new_api_relay_requests_total{provider=~\"$provider\"}[$__rate_interval]))", "legendFormat": "final · {{provider}}"},
        {"refId": "B", "expr": "sum by (provider) (rate(new_api_relay_attempts_total{provider=~\"$provider\"}[$__rate_interval]))", "legendFormat": "attempt · {{provider}}"},
        {"refId": "C", "expr": "sum by (provider) (rate(new_api_relay_retries_total{provider=~\"$provider\"}[$__rate_interval]))", "legendFormat": "retry · {{provider}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 10, "type": "timeseries", "title": "Upstream attempt failures", "description": "Shows failed internal attempts even when a retry later succeeds.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (provider, error_class, upstream_status) (rate(new_api_relay_attempts_total{provider=~\"$provider\",error_class!=\"success\"}[$__rate_interval]))", "legendFormat": "{{provider}} · {{error_class}} · {{upstream_status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "bars", "fillOpacity": 50, "stacking": {"mode": "normal", "group": "attempt-errors"}}}, "overrides": []}
    },
    {"id": 11, "type": "row", "title": "Latency, concurrency, and ikun behavior", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25}, "collapsed": false, "panels": []},
    {
      "id": 12, "type": "timeseries", "title": "End-to-end final latency", "description": "Client-visible total relay duration.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(new_api_relay_request_duration_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "P50 · {{provider}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(new_api_relay_request_duration_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "P95 · {{provider}}"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(new_api_relay_request_duration_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "P99 · {{provider}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 13, "type": "timeseries", "title": "Single upstream attempt latency", "description": "Separates downstream latency from total retry duration.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(new_api_relay_attempt_duration_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "P50 · {{provider}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(new_api_relay_attempt_duration_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "P95 · {{provider}}"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(new_api_relay_attempt_duration_seconds_bucket{provider=~\"$provider\"}[$__rate_interval])))", "legendFormat": "P99 · {{provider}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 14, "type": "timeseries", "title": "Relay in-flight requests", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (provider) (new_api_relay_in_flight{provider=~\"$provider\"})", "legendFormat": "{{provider}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 15, "type": "timeseries", "title": "Client cancellations by phase", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (provider, phase) (rate(new_api_relay_client_cancellations_total{provider=~\"$provider\"}[$__rate_interval]))", "legendFormat": "{{provider}} · {{phase}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "bars", "fillOpacity": 50}}, "overrides": []}
    },
    {
      "id": 16, "type": "timeseries", "title": "ikun responses by HTTP status", "description": "Derived directly from structured access logs; available before the AllToken image release.", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 34},
      "datasource": {"type": "loki", "uid": "loki-ikun"},
      "targets": [{"refId": "A", "expr": "sum by (status_code) (count_over_time({job=\"ikun/sub2api\",component=\"http.access\"} | json [$__auto]))", "legendFormat": "HTTP {{status_code}}", "queryType": "range"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 18}}, "overrides": []}
    },
    {"id": 17, "type": "row", "title": "Host resources and observability health", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 42}, "collapsed": false, "panels": []},
    {
      "id": 18, "type": "timeseries", "title": "CPU busy · both hosts", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 43},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{host=~\"alltoken|ikun\",mode=\"idle\"}[$__rate_interval])))", "legendFormat": "{{host}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 19, "type": "timeseries", "title": "Memory used · both hosts", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 43},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes{host=~\"alltoken|ikun\"} / node_memory_MemTotal_bytes{host=~\"alltoken|ikun\"})", "legendFormat": "{{host}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 20, "type": "timeseries", "title": "Root disk used · both hosts", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 43},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{host=~\"alltoken|ikun\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{host=~\"alltoken|ikun\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})", "legendFormat": "{{host}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 85}]}, "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 21, "type": "timeseries", "title": "Network throughput · both hosts", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 51},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (host) (rate(node_network_receive_bytes_total{host=~\"alltoken|ikun\",device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval]))", "legendFormat": "RX · {{host}}"},
        {"refId": "B", "expr": "sum by (host) (rate(node_network_transmit_bytes_total{host=~\"alltoken|ikun\",device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval]))", "legendFormat": "TX · {{host}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 22, "type": "timeseries", "title": "Loki ingestion and Alloy drops", "description": "Loki lines received and Alloy entries dropped. Dropped entries should remain zero.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 51},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (host) (rate(loki_distributor_lines_received_total{job=~\"loki-alltoken|loki-ikun\"}[$__rate_interval]))", "legendFormat": "lines · {{host}}"},
        {"refId": "B", "expr": "sum by (host) (rate(loki_write_dropped_entries_total{job=~\"alloy-alltoken|alloy-ikun\"}[$__rate_interval]))", "legendFormat": "dropped · {{host}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {"id": 23, "type": "row", "title": "Request-ID drill-down", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 59}, "collapsed": false, "panels": []},
    {
      "id": 24, "type": "logs", "title": "AllToken relay events", "description": "Filter with server request_id, client_trace_id, or upstream_request_id.", "gridPos": {"h": 12, "w": 12, "x": 0, "y": 60},
      "datasource": {"type": "loki", "uid": "loki-alltoken"},
      "targets": [{"refId": "A", "expr": "{job=\"alltoken/new-api\"} |= \"observability_event=\" |= \"${request_id}\"", "queryType": "range"}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none"}
    },
    {
      "id": 25, "type": "logs", "title": "ikun correlated events", "description": "Matches ikun request_id or client_request_id. The latter equals the AllToken server request ID after release.", "gridPos": {"h": 12, "w": 12, "x": 12, "y": 60},
      "datasource": {"type": "loki", "uid": "loki-ikun"},
      "targets": [{"refId": "A", "expr": "{job=\"ikun/sub2api\"} |= \"${request_id}\" | json", "queryType": "range"}],
      "options": {"showTime": true, "showLabels": false, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending", "dedupStrategy": "none"}
    },
    {
      "id": 26, "type": "table", "title": "Active observability alerts", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 72},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "ALERTS{alertstate=\"firing\",alertname=~\"Observability.*|RemoteHost.*|AllTokenRelay.*\"}", "format": "table", "instant": true}],
      "options": {"showHeader": true}, "fieldConfig": {"defaults": {}, "overrides": []}
    }
  ],
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard"}]},
  "links": [
    {"title": "Prometheus", "url": "http://localhost:9090", "type": "link", "keepTime": true},
    {"title": "Load-test dashboard", "url": "/d/new-api-loadtest/new-api-load-test", "type": "link", "keepTime": true}
  ]
}
