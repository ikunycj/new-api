{
  "uid": "new-api-loadtest",
  "title": "Remote ECS · new-api load test",
  "description": "Grafana runs locally. All panels scoped to jobs new-api, node, postgres, and redis visualize the remote Hong Kong ECS through the SSH tunnel.",
  "tags": ["new-api", "loadtest"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {"name": "route", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": "label_values(new_api_http_requests_total, route)", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Relay error rate", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(new_api_http_requests_total{route_tag=\"relay\",status=~\"5..\"}[2m])) / clamp_min(sum(rate(new_api_http_requests_total{route_tag=\"relay\"}[2m])), 0.001)", "legendFormat": "5xx %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []}
    },
    {
      "id": 2, "type": "stat", "title": "Relay requests / sec", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(new_api_http_requests_total{route_tag=\"relay\"}[1m]))", "legendFormat": "RPS"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "In-flight requests", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "new_api_http_requests_in_flight", "legendFormat": "requests"}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 750}, {"color": "red", "value": 900}]}}, "overrides": []}
    },
    {
      "id": 4, "type": "stat", "title": "Active mock upstream", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "mock_openai_requests_active", "legendFormat": "requests"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "Request rate by route", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"refId": "A", "expr": "sum by (route) (rate(new_api_http_requests_total{route=~\"$route\"}[1m]))", "legendFormat": "{{route}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "P50 / P95 / P99 chat latency", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(new_api_http_request_duration_seconds_bucket{route=\"/v1/chat/completions\"}[5m])))", "legendFormat": "P50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(new_api_http_request_duration_seconds_bucket{route=\"/v1/chat/completions\"}[5m])))", "legendFormat": "P95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(new_api_http_request_duration_seconds_bucket{route=\"/v1/chat/completions\"}[5m])))", "legendFormat": "P99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "Go runtime", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"refId": "A", "expr": "go_goroutines{job=\"new-api\"}", "legendFormat": "goroutines"},
        {"refId": "B", "expr": "go_memstats_heap_alloc_bytes{job=\"new-api\"}", "legendFormat": "heap alloc"},
        {"refId": "C", "expr": "rate(process_cpu_seconds_total{job=\"new-api\"}[1m])", "legendFormat": "CPU cores"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": [{"matcher": {"id": "byName", "options": "heap alloc"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "custom.axisPlacement", "value": "right"}]}]}
    },
    {
      "id": 8, "type": "timeseries", "title": "Database pool", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"refId": "A", "expr": "new_api_database_connections{database=\"main\"}", "legendFormat": "{{state}}"},
        {"refId": "B", "expr": "rate(new_api_database_wait_count_total{database=\"main\"}[1m])", "legendFormat": "waits/sec"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Redis pool", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {"refId": "A", "expr": "new_api_redis_pool_connections", "legendFormat": "{{state}}"},
        {"refId": "B", "expr": "rate(new_api_redis_pool_timeouts_total[1m])", "legendFormat": "timeouts/sec"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 10, "type": "timeseries", "title": "PostgreSQL and Redis exporters", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {"refId": "A", "expr": "sum(pg_stat_activity_count)", "legendFormat": "PostgreSQL connections"},
        {"refId": "B", "expr": "redis_connected_clients", "legendFormat": "Redis clients"},
        {"refId": "C", "expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "Redis commands/sec"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 11, "type": "timeseries", "title": "Remote ECS CPU and memory", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[1m])))", "legendFormat": "CPU {{instance}}"},
        {"refId": "B", "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})", "legendFormat": "memory {{instance}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 12, "type": "table", "title": "Active alerts", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [{"refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    },
    {
      "id": 13, "type": "timeseries", "title": "k6 VUs and request rate", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 36},
      "targets": [
        {"refId": "A", "expr": "k6_vus", "legendFormat": "VUs"},
        {"refId": "B", "expr": "rate(k6_http_reqs_total[1m])", "legendFormat": "k6 RPS"},
        {"refId": "C", "expr": "k6_http_req_failed_rate", "legendFormat": "k6 failed rate"},
        {"refId": "D", "expr": "rate(k6_dropped_iterations_total[1m])", "legendFormat": "dropped iterations/sec"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 14, "type": "timeseries", "title": "Token throughput", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 44},
      "targets": [
        {"refId": "A", "expr": "rate(k6_new_api_prompt_tokens_total[1m])", "legendFormat": "input Token TPS"},
        {"refId": "B", "expr": "rate(k6_new_api_completion_tokens_total[1m])", "legendFormat": "output Token TPS"},
        {"refId": "C", "expr": "rate(k6_new_api_total_tokens_total[1m])", "legendFormat": "total Token TPS"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 0, "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 15, "type": "row", "title": "Remote bottleneck diagnosis · select a test time range", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 52}, "collapsed": false, "panels": []
    },
    {
      "id": 16, "type": "text", "title": "What this dashboard is showing", "gridPos": {"h": 5, "w": 24, "x": 0, "y": 53},
      "options": {"mode": "markdown", "content": "### Data source\nGrafana and Prometheus run **locally**, while `new-api`, `node`, `postgres`, and `redis` are scraped from the **remote Hong Kong ECS through the SSH tunnel**. The Mac is not represented in the remote resource panels.\n\n### Mixed workload gate: 200 VUs failed, 500 VUs not executed\nThe workload used **10 short + 190 large VUs** (5% / 95%). Short requests calibrated at 44 tokens; large requests at 2,292 tokens. The 200-VU stage produced 7,457 requests: 2,143 HTTP 200, 5,313 HTTP 429, 0 HTTP 5xx, and 1 transport timeout. Overall error rate was **71.26%**.\n\n| Workload | HTTP 200 | HTTP 429 | status=0 | Error rate | P95 | P99 |\n|---|---:|---:|---:|---:|---:|---:|\n| Short | 389 | 260 | 0 | 40.06% | 3.45s | 6.11s |\n| Large | 1,754 | 5,053 | 1 | 74.24% | 13.31s | 21.56s |\n\nAll tokens share one user-level 1,000 requests/minute limiter. Once the success bucket filled, 429 responses returned in milliseconds; closed-loop VUs immediately retried and amplified the 429 rate. One large request reached the 120-second client timeout. ECS resources remained moderate, so 500 VUs were blocked by the safety gate rather than host saturation.\n\n[Open the 200 VU mixed window](/d/new-api-loadtest/new-api-load-test?orgId=1&from=1786263441000&to=1786263582230&refresh=5s) · [Open the 100 VU large-token window](/d/new-api-loadtest/new-api-load-test?orgId=1&from=1786262312000&to=1786262449870&refresh=5s) · [Open the 50 VU large-token window](/d/new-api-loadtest/new-api-load-test?orgId=1&from=1786261598000&to=1786261780000&refresh=5s)"}
    },
    {
      "id": 17, "type": "timeseries", "title": "Remote chat responses by HTTP status", "description": "Application-side response rate from the remote new-api instance. Stacked to show when 429/5xx replace successful traffic.", "gridPos": {"h": 9, "w": 16, "x": 0, "y": 58},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\"}[$__rate_interval]))", "legendFormat": "HTTP {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 35, "stacking": {"mode": "normal", "group": "status"}}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "/HTTP 2../"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
        {"matcher": {"id": "byName", "options": "HTTP 429"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
        {"matcher": {"id": "byRegexp", "options": "/HTTP 5../"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]}
    },
    {
      "id": 18, "type": "piechart", "title": "Response composition in selected range", "description": "Increase of remote chat response counters over the selected dashboard range.", "gridPos": {"h": 9, "w": 8, "x": 16, "y": 58},
      "targets": [{"refId": "A", "expr": "sum by (status) (increase(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\"}[$__range]))", "legendFormat": "HTTP {{status}}", "instant": true}],
      "options": {"pieType": "donut", "displayLabels": ["name", "percent"], "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "tooltip": {"mode": "single", "sort": "desc"}},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "/HTTP 2../"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
        {"matcher": {"id": "byName", "options": "HTTP 429"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
        {"matcher": {"id": "byRegexp", "options": "/HTTP 5../"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]}
    },
    {
      "id": 19, "type": "stat", "title": "Success ratio", "gridPos": {"h": 5, "w": 8, "x": 0, "y": 67},
      "targets": [{"refId": "A", "expr": "100 * sum(increase(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\",status=~\"2..\"}[$__range])) / clamp_min(sum(increase(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\"}[$__range])), 1)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 95}, {"color": "green", "value": 99}]}}, "overrides": []}
    },
    {
      "id": 20, "type": "stat", "title": "HTTP 429 ratio", "gridPos": {"h": 5, "w": 8, "x": 8, "y": 67},
      "targets": [{"refId": "A", "expr": "100 * sum(increase(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\",status=\"429\"}[$__range])) / clamp_min(sum(increase(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\"}[$__range])), 1)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []}
    },
    {
      "id": 21, "type": "stat", "title": "HTTP 5xx ratio", "gridPos": {"h": 5, "w": 8, "x": 16, "y": 67},
      "targets": [{"refId": "A", "expr": "100 * sum(increase(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\",status=~\"5..\"}[$__range])) / clamp_min(sum(increase(new_api_http_requests_total{job=\"new-api\",route=\"/v1/chat/completions\"}[$__range])), 1)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []}
    },
    {
      "id": 22, "type": "timeseries", "title": "Remote ECS saturation check", "description": "Low CPU and memory usage while errors spike indicates that the host is not the bottleneck.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 72},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[$__rate_interval])))", "legendFormat": "ECS CPU busy"},
        {"refId": "B", "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})", "legendFormat": "ECS memory used"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []}
    },
    {
      "id": 23, "type": "timeseries", "title": "Remote dependencies and app concurrency", "description": "PostgreSQL, Redis, and application concurrency remain modest during the 50 VU failure spike.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 72},
      "targets": [
        {"refId": "A", "expr": "sum(pg_stat_activity_count{job=\"postgres\"})", "legendFormat": "PostgreSQL connections"},
        {"refId": "B", "expr": "redis_connected_clients{job=\"redis\"}", "legendFormat": "Redis clients"},
        {"refId": "C", "expr": "go_goroutines{job=\"new-api\"}", "legendFormat": "new-api goroutines"},
        {"refId": "D", "expr": "new_api_http_requests_in_flight{job=\"new-api\"}", "legendFormat": "requests in flight"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 24, "type": "row", "title": "Pool and cluster failover", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 81}, "collapsed": false, "panels": []
    },
    {
      "id": 25, "type": "timeseries", "title": "Remaining tokens by cluster pool", "description": "The pool-failover profile consumes 30 mock tokens per successful request. P1 is free, P2 is Pro/Plus, and P3 is fallback.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 82},
      "targets": [{"refId": "A", "expr": "mock_cluster_pool_remaining_tokens", "legendFormat": "C{{cluster_code}} P{{pool_tier}} {{pool}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []}
    },
    {
      "id": 26, "type": "timeseries", "title": "Pool consumption and routing attempts", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 82},
      "targets": [
        {"refId": "A", "expr": "rate(mock_cluster_pool_consumed_tokens_total[1m])", "legendFormat": "C{{cluster_code}} P{{pool_tier}} token/s"},
        {"refId": "B", "expr": "sum by (cluster_code, pool_tier, outcome) (rate(alltoken_pool_requests_total[1m]))", "legendFormat": "C{{cluster_code}} P{{pool_tier}} {{outcome}} req/s"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 27, "type": "timeseries", "title": "Cluster failover and circuit state", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 90},
      "targets": [
        {"refId": "A", "expr": "sum by (from_cluster, to_cluster, mode) (rate(alltoken_cluster_failover_total[1m]))", "legendFormat": "C{{from_cluster}} to C{{to_cluster}} {{mode}}"},
        {"refId": "B", "expr": "alltoken_cluster_circuit_state{state=~\"open|half_open\"}", "legendFormat": "C{{cluster_code}} {{state}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 12}}, "overrides": []}
    },
    {
      "id": 28, "type": "timeseries", "title": "Errors by stable AllToken code", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 90},
      "targets": [{"refId": "A", "expr": "sum by (event_kind, alltoken_code, category, cluster_code) (rate(alltoken_error_events_total[1m]))", "legendFormat": "{{event_kind}} {{alltoken_code}} {{category}} C{{cluster_code}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 29, "type": "timeseries", "title": "Failover latency", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 98},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, outcome, mode) (rate(alltoken_failover_duration_seconds_bucket[5m])))", "legendFormat": "P95 {{outcome}} {{mode}}"},
        {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le, outcome, mode) (rate(alltoken_failover_duration_seconds_bucket[5m])))", "legendFormat": "P99 {{outcome}} {{mode}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 30, "type": "table", "title": "Failover alerts", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 98},
      "targets": [{"refId": "A", "expr": "ALERTS{alertname=~\"AllTokenClusterCircuitOpen|AllTokenUpstreamExhausted|AllTokenPoolTokensLow|AllTokenPoolExhausted|AllTokenFailoverSurge\"}", "format": "table", "instant": true}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    }
