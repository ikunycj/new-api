# Keep deployment artifacts local while tracking the deployment documentation.
*
!.gitignore
!README.md
!loadtest/
!loadtest/**
!observability/
!observability/**
observability/**/data/
!ikun.love/
!ikun.love/**
ikun.love/.env
ikun.love/.env.tmp.*
ikun.love/.env.approved.sha256
ikun.love/deployment.env
ikun.love/*.tar.gz
ikun.love/.staging/
ikun.love/artifacts/
ikun.love/migration-reports/
ikun.love/migration-snapshots/
