# Unified timeout policy for the application and its gateway.
# Values are seconds. Keep this file free of credentials.
TIMEOUT_CONFIG_VERSION=1

RELAY_TIMEOUT=0
STREAMING_TIMEOUT=300
RELAY_IDLE_CONN_TIMEOUT=90
STREAM_CLIENT_WRITE_TIMEOUT=30
SHUTDOWN_TIMEOUT_SECONDS=120

GATEWAY_CONNECT_TIMEOUT_SECONDS=15
GATEWAY_READ_TIMEOUT_SECONDS=600
GATEWAY_SEND_TIMEOUT_SECONDS=600
UPSTREAM_FAIL_TIMEOUT_SECONDS=10
